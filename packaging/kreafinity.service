# Generated by « kreafinity setup » into ~/.config/systemd/user/kreafinity.service
# (copy shown for reference, with the installer's default environment).
[Unit]
Description=Kreafinity, l'assistant système (démon local)
Documentation=https://github.com/LAWD-CREATION/kreafinity-OS
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/share/kreafinity/venv/bin/python -m kreafinity.api.server
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
