#!/bin/sh
# Kreafinity: enable the daemon for every user, and pick the taskbar widget
# matching the installed Plasma (5 or 6).
set -e

widget=/usr/share/plasma/plasmoids/org.kreafinity.assistant

plasma_major() {
    if command -v plasmashell >/dev/null 2>&1; then
        QT_QPA_PLATFORM=offscreen plasmashell --version 2>/dev/null \
            | sed -n 's/^plasmashell \([0-9]*\)\..*/\1/p' | head -n 1
    fi
}

case "$1" in
    configure)
        if command -v systemctl >/dev/null 2>&1; then
            # Starts with each graphical session from the next login on.
            systemctl --global enable kreafinity.service >/dev/null 2>&1 || true
        fi
        version="$(plasma_major || true)"
        [ "$version" = 5 ] || version=6
        mkdir -p /usr/share/plasma/plasmoids
        rm -rf "$widget"
        ln -s "/opt/kreafinity/share/plasmoids/$version" "$widget"
        # Updates with the system: the Kreafinity APT repository, unless already set up
        # (by hand, or by an earlier installation).
        if [ -f /usr/share/kreafinity/kreafinity.sources ] \
            && [ ! -e /etc/apt/sources.list.d/kreafinity.sources ] \
            && [ ! -e /etc/apt/sources.list.d/kreafinity.list ]; then
            cp /usr/share/kreafinity/kreafinity.sources /etc/apt/sources.list.d/kreafinity.sources
        fi
        if command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true
        fi
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications || true
        fi
        ;;
esac
exit 0
