#!/bin/sh
# The users' own data (settings, conversations, memory) stay in their home
# folders: « kreafinity uninstall --purge » before removing the package erases them.
set -e
case "$1" in
    remove|purge)
        rm -rf /usr/share/plasma/plasmoids/org.kreafinity.assistant
        ;;
esac
case "$1" in
    purge)
        # Removing the package keeps the repository (reinstalling is one command);
        # purging it forgets it.
        rm -f /etc/apt/sources.list.d/kreafinity.sources
        ;;
esac
exit 0
